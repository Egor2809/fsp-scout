{
  "name": "scout-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "node --import ./scripts/real-env.mjs ./node_modules/vite/bin/vite.js",
    "generate:api": "orval --config orval.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "build:real": "tsc -b && node --import ./scripts/real-env.mjs ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview"
  },
