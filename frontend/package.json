    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/jura": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/wix-madefor-display": "^5.3.0",
    "@fontsource-variable/wix-madefor-text": "^5.3.0",
    "@fontsource-variable/ysabeau-office": "^5.3.0",
    "@fontsource/oranienbaum": "^5.3.0",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "motion": "^14.0.0",
    "msw": "^3.0.2",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
