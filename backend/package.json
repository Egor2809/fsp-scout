{
  "name": "scout-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "assessment:retry": "tsx scripts/retry-code-job.ts",
    "contract:snapshot": "node scripts/check-contract-snapshot.mjs",
    "contract:matrix": "node scripts/update-api-matrix.mjs",
    "test": "node --experimental-strip-types --test --test-isolation=none test/*.test.ts",
    "eval": "node --experimental-strip-types eval/validate.ts",
    "test:integration": "node --test --test-isolation=none integration/*.test.mjs",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "llm:drafts": "node --experimental-strip-types scripts/llm-draft-items.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.16.2",
    "bullmq": "5.58.5",
    "jose": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
